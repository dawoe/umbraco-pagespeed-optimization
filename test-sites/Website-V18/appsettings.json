{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "ee390875-f5ea-4de0-a532-51a2a60a385c",
        "SanitizeTinyMce": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "Imaging": {
        "HMACSecretKey": "WDp9UV76UWGnnK0i54BbInx5i0FFDlGGaNhZE/nME5gzPHZMmEhO6kU3YAzUUQ0s4oIr1vHN4PVVV2wVzk08pw=="
      }
    },
    "Community": {
      "PageSpeedOptimizer": {
        "StaticAssetsCache": {
          "Enabled": true,
          "CacheBackOffice": true
        },
        "ResponseCompression": {
          "Enabled": true
        },
        "ImageOptimization": {
          "Enabled": true,
          "DefaultImageQuality": 70,
          "ForceWebP": true
        }
      }
    }
  }
}